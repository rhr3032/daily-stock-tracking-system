{
  "buildCommand": "prisma generate && vite build",
  "devCommand": "concurrently \"vite\" \"tsx watch server/index.ts\"",
  "functions": {
    "api/[...path].ts": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
